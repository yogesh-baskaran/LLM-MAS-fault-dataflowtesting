# COPY TO config.env, then replace EVERY FILL_ME value. Bash syntax.
# OPTIONAL BATCH SUBMISSION DETAILS. Leave account blank when using your existing
# salloc allocation. setup.sh and job.sh automatically use that allocation.
# Only submit.sh needs an account; no password or SSH key belongs here.
SPEED_ACCOUNT=""
SPEED_PARTITION="pt"

# YOUR REPOSITORY LOCATION ON SPEED (existing checkout, read-only to this harness):
DF_REPO="/speed-scratch/y_baskar/fall 2026/LLM-MAS-fault-injection"

# YOUR TESTING PROJECT LOCATION ON SPEED:
DF_ROOT="/speed-scratch/y_baskar/fall 2026/payment-dataflow-speed"

# Confirm these modules with `module avail` inside your allocation:
PYTHON_MODULE="python/3.11.6/default"
SINGULARITY_MODULE="singularity/3.10.4/default"
MODULE_INIT="/encs/pkg/modules-5.3.1/root/init/bash"

# One GPU; optional gpu20 matches the manual's A100 MIG nodes. Leave empty
# to let your authorized partition choose; verify GPU memory before experimenting.
SPEED_CONSTRAINT=""
SPEED_MEMORY="32G"
SPEED_CPUS="4"
SPEED_TIME="04:00:00"

# Dedicated test services on the allocated node; not website service addresses:
DF_PAYMENT_PORT="50061"
DF_MONGO_PORT="27027"
DF_OLLAMA_PORT="11444"
DF_MODEL="qwen2.5-coder:14b"
DF_CONTEXT="8192"
DF_ROUNDS="2"
DF_GENERATED_PER_ROUND="6"

# Suites: payment, currency, emailservice, recommendation, cart, checkout, or all.
# An argument to job.sh overrides this setting: bash speed/job.sh all
DF_AGENTS="payment"
DF_CART_PORT="50062"
DF_CURRENCY_PORT="50063"
DF_EMAIL_PORT="50064"
DF_RECOMMENDATION_PORT="50065"
DF_CHECKOUT_PORT="50066"
DF_CATALOG_PORT="50067"
DF_SHIPPING_PORT="50068"
# Bounded statement-CFG path analysis. Three visits permits limited loop paths.
DF_MAX_NODE_VISITS="3"
DF_MAX_PATHS="10000"

# Optional: your EXISTING executable Ollama path; empty uses the prepared SIF.
OLLAMA_BIN=""
# Optional: your EXISTING model cache on SPEED; no model is loaded locally.
OLLAMA_MODELS="$DF_ROOT/cache/ollama-models"

